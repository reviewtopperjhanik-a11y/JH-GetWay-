# JH GetWay uses a Bring-Your-Own-Key (BYOK) runtime architecture.
# Upstream provider API keys, local server tokens, and MCP credentials are stored
# exclusively at runtime inside the Android Keystore AES-256-GCM encrypted Vault.
# Never place production provider API keys in this file or commit .env to VCS.
#
# GEMINI_API_KEY: Optional AI Studio environment placeholder (left commented out so no key is bundled into the APK).
# GEMINI_API_KEY=MY_GEMINI_API_KEY
